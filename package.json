    "qa": "node dist/cli.js",
    "mcp": "node dist/mcp.js",
    "demo": "node scripts/demonstrar.mjs",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": { "@modelcontextprotocol/sdk": "1.32.1", "zod": "^3.25.76" },
  "devDependencies": { "@types/node": "^24.0.0", "typescript": "^5.9.3" }
