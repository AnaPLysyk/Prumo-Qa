{
  "name": "prumo-qa",
  "version": "2.1.0",
  "description": "Engenharia de qualidade local: contexto, contratos, MCP e evidências",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "prumo": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "docs",
    "scripts/aprovar.cs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-broker.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --experimental-test-module-mocks --test --test-concurrency=1 testes/*.test.mjs",
    "qa": "node dist/cli.js",
    "mcp": "node dist/mcp.js",
    "demo": "node scripts/demonstrar.mjs",
    "check": "npm run typecheck && npm test",
    "prumo": "node dist/cli.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "pino": "10.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
