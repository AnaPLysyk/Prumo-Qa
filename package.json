{
  "name": "prumo-qa",
  "version": "2.0.0",
  "description": "Engenharia de qualidade local: contexto, contratos, MCP e evidências",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": { "qa": "dist/cli.js" },
  "files": ["dist", "skills", "scripts/aprovar.cs", "README.md"],
