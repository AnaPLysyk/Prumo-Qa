{
  "name": "prumo-qa",
  "version": "2.18.0",
  "description": "Engenharia de qualidade local: contexto, contratos, MCP, evidências e aplicativo desktop Windows",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "prumo": "dist/cli.js"
  },
  "files": [
    "dist",
    "backend/agentes/skills",
    "docs",
    "backend/aplicativo/preload.cjs",
    "assets",
    "ferramentas/empacotamento/aprovar.cs",
    "README.md"
  ],
  "scripts": {
    "build": "node ferramentas/arquitetura/dependencias.mjs && node ferramentas/frontend/sincronizar-frontend.mjs && node ferramentas/frontend/gerar-telas-modulares.mjs && tsc && node ferramentas/arquitetura/gerar-mapa-do-aplicativo.mjs && node ferramentas/empacotamento/gerar-status.mjs && node ferramentas/empacotamento/build-broker.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --require ./testes/apoio/conhecimento-hook.cjs --experimental-test-module-mocks --test --test-concurrency=1 \"testes/**/*.test.mjs\"",
    "qa": "node dist/cli.js",
    "mcp": "node dist/mcp.js",
    "demo": "node ferramentas/demonstracao/demonstrar.mjs",
    "check": "npm run dependencias && npm run typecheck && npm test",
    "check:isolado": "npm run dependencias && npm run typecheck && npm run build && node ferramentas/testes/executar.mjs --isolado",
    "dependencias": "node ferramentas/arquitetura/dependencias.mjs",
    "test:selecionar": "node ferramentas/testes/executar.mjs",
    "test:unitarios": "node ferramentas/testes/executar.mjs --natureza unitario",
    "test:smoke": "node ferramentas/testes/executar.mjs --natureza smoke",
    "test:regressao": "node ferramentas/testes/executar.mjs --natureza regressao",
    "test:backend": "node ferramentas/testes/executar.mjs --camada backend",
    "test:frontend": "node ferramentas/testes/executar.mjs --camada frontend",
    "prumo": "node dist/cli.js",
    "prepack": "npm run build",
    "app": "npm run build && electron .",
    "icone": "electron ferramentas/empacotamento/gerar-icone-orb.cjs",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --arm64 --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --publish never",
    "contratos": "npm run build && node ferramentas/documentacao/gerar-contratos.mjs",
    "site": "node site/gerar.mjs",
    "leia-me": "node ferramentas/documentacao/gerar-leia-me-backend.mjs",
    "arquitetura": "node ferramentas/arquitetura/gerar-arquitetura.mjs",
    "frontend:check": "node ferramentas/frontend/sincronizar-frontend.mjs --check",
    "frontend:sync": "node ferramentas/frontend/sincronizar-frontend.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "pino": "10.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "playwright-core": "1.64.0",
    "three": "0.159.0",
    "typescript": "^5.9.3"
  },
  "author": {
    "name": "Ana P. Lysyk",
    "url": "https://github.com/AnaPLysyk"
  },
  "homepage": "https://github.com/AnaPLysyk/Prumo-Qa",
  "main": "dist/aplicativo.js"
}
